    },
    {
      "id": "H03",
      "name": "Pinned profile and semantic validation"
    },
    {
      "id": "H04",
      "name": "Durable acknowledgement and uncertain outcomes"
    },
    {
      "id": "H05",
      "name": "Stable append order and overflow"
    },
    {
      "id": "H06",
      "name": "Finite quotas and accounting"
    },
    {
      "id": "H07",
      "name": "Retention and receiver clock"
    },
    {
      "id": "H08",
      "name": "Append-only correction links"
    },
    {
      "id": "H09",
      "name": "Bounded reads and sparse continuation"
    },
    {
      "id": "H10",
      "name": "Explicit pruning and unavailable evidence"
    },
    {
      "id": "H11",
      "name": "Recovery and corruption"
    },
    {
      "id": "H12",
      "name": "Restore prefix identity"
    },
    {
      "id": "H13",
      "name": "Single-writer ownership and fencing"
    },
    {
      "id": "H14",
      "name": "Current assessment separate from receipt"
    },
    {
      "id": "H15",
      "name": "Receiver rejection and independent health"
    },
    {
      "id": "H16",
      "name": "Scope limits and finite identity guarantees"
    }
