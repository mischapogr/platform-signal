{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "imagePullSecrets",
    "service",
    "persistence",
    "auth",
    "rules",
    "resources",
    "terminationGracePeriodSeconds",
    "probes",
    "pdb",
    "serviceMonitor",
    "podAnnotations",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "limits"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "metricsPort"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "storageClass"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "key"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingConfigMap",
        "keys"
      ],
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.ya?ml$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "existingConfigMap": {
                "minLength": 1
              }
            }
          },
          "then": {
            "properties": {
              "keys": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 15
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup",
        "readiness",
        "liveness"
      ],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periodSeconds",
            "failureThreshold"
          ],
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "labels",
        "interval",
        "scrapeTimeout"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryEvents",
        "memoryBytes",
        "walBytes",
        "storageBytes",
        "findingsBytes",
        "queryMemoryBytes",
        "queryConcurrency",
        "requestBytes",
        "batchEvents"
      ],
      "properties": {
        "memoryEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "walBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "storageBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "findingsBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "queryMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "queryConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "batchEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
