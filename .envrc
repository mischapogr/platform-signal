# Project environment for SIGNAL and its Context7 MCP launcher.
# Keep credentials in ignored dotenv files. Run `direnv allow` after edits.
# .env.mcp.local overrides .env; an inherited Context7 key takes precedence.
signal_load_env() {
  local inherited_context7_key="${CONTEXT7_API_KEY:-}"

  # These helpers also watch missing files, so creating either triggers reload.
  dotenv_if_exists .env
  dotenv_if_exists .env.mcp.local

  if [[ -n "$inherited_context7_key" ]]; then
    export CONTEXT7_API_KEY="$inherited_context7_key"
  fi
}

signal_load_env
unset -f signal_load_env
