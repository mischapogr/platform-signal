%% Target onboarding workflow: verify coverage before enabling rules.
flowchart LR
    A["1. Discover scope<br/>accounts, log categories,<br/>private ownership mapping"] --> B["2. Grant least privilege<br/>source roles, access tests,<br/>independent evidence policy"]
    B --> C{"3. Verify collection<br/>known test events +<br/>continuity + observer health"}
    C -->|"proof passes"| D["4. Activate detections<br/>only supported rule packs<br/>company routing + tuning"]
    C -->|"validation fails"| F["Fix gaps, keep rules disabled<br/>retain independent originals<br/>record limits"]
    F --> B
    D -.->|"unknown coverage blocks a<br/>clean-security claim"| C
    classDef source fill:#fff7ed,stroke:#c2410c,color:#431407
    classDef collector fill:#eff6ff,stroke:#1d4ed8,color:#172554
    classDef core fill:#ecfdf5,stroke:#047857,color:#022c22
    classDef evidence fill:#fef2f2,stroke:#b91c1c,color:#450a0a
    classDef people fill:#f5f3ff,stroke:#6d28d9,color:#2e1065
    classDef store fill:#f1f5f9,stroke:#334155,color:#0f172a
    class A,B,C collector
    class D core
    class F evidence
