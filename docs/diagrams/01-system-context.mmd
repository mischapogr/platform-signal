%% PLATFORM::SIGNAL system context. Target view; see docs/27-product-architecture.md.
%% Thick arrow = native protected delivery that bypasses observability; dashed = reference, policy or review.
flowchart TB
    subgraph SOURCES["Evidence sources"]
        AWS["AWS audit<br/>+ service logs"]
        K8S["Kubernetes<br/>audit + state"]
        HOSTS["Hosts +<br/>applications"]
        SAAS["Selected SaaS<br/>+ syslog"]
    end
    SIGNAL["PLATFORM::SIGNAL<br/>capture, admit, normalize,<br/>detect, query, findings<br/>modular Rust monolith"]
    IDP["Company IdP<br/>OIDC sign-in"]
    TEAM["DevOps - SecOps<br/>Architects"]
    subgraph STATE["Customer-owned AWS storage"]
        TELE[("Telemetry S3<br/>Parquet + manifests")]
        CTRL[("Control state<br/>Small: local<br/>Standard: HA PostgreSQL")]
        ORIG[("Security-owned S3<br/>protected originals")]
    end
    OVERLAY["Private overlay<br/>policy, routing,<br/>ownership"]
    DEST["Alert + ticket<br/>destinations"]
    AWS --> SIGNAL
    K8S --> SIGNAL
    HOSTS --> SIGNAL
    SAAS --> SIGNAL
    IDP --> SIGNAL
    TEAM --> SIGNAL
    SIGNAL --> TELE
    SIGNAL --> CTRL
    AWS ==>|"native protected delivery"| ORIG
    ORIG -.-> SIGNAL
    SIGNAL --> OVERLAY --> DEST
    OVERLAY -.-> SIGNAL
    classDef source fill:#fff7ed,stroke:#c2410c,color:#431407
    classDef collector fill:#eff6ff,stroke:#1d4ed8,color:#172554
    classDef core fill:#ecfdf5,stroke:#047857,color:#022c22
    classDef evidence fill:#fef2f2,stroke:#b91c1c,color:#450a0a
    classDef people fill:#f5f3ff,stroke:#6d28d9,color:#2e1065
    classDef store fill:#f1f5f9,stroke:#334155,color:#0f172a
    class AWS,K8S,HOSTS,SAAS source
    class SIGNAL core
    class TELE,CTRL store
    class ORIG evidence
    class TEAM,IDP,OVERLAY,DEST people
