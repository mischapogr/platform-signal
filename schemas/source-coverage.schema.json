{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform-signal:source-coverage:1",
  "title": "Proposed SourceCoverage v1",
  "$comment": "Structural schema only. UTF-8/serialized byte bounds, calendar validity, profile/status, interval, trust and freshness semantics are specified in docs/source-coverage-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_id",
    "collector_id",
    "resource_scope",
    "expected_stream",
    "coverage_profile",
    "coverage_start",
    "coverage_end",
    "last_observed_at",
    "last_verified_at",
    "valid_until",
    "checkpoint",
    "collection_config_revision",
    "validation_status",
    "validation",
    "gaps",
    "gap_summary",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "record_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_id": {
      "$ref": "#/$defs/identifier"
    },
    "collector_id": {
      "$ref": "#/$defs/identifier"
    },
    "resource_scope": {
      "$ref": "#/$defs/scope"
    },
    "expected_stream": {
      "$ref": "#/$defs/identifier"
    },
    "coverage_profile": {
      "$ref": "#/$defs/profile_ref"
    },
    "coverage_start": {
      "$ref": "#/$defs/timestamp"
    },
    "coverage_end": {
      "$ref": "#/$defs/timestamp"
    },
    "last_observed_at": {
      "$ref": "#/$defs/nullable_timestamp"
    },
    "last_verified_at": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "#/$defs/timestamp"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "collection_config_revision": {
      "$ref": "#/$defs/identifier"
    },
    "validation_status": {
      "$ref": "#/$defs/status"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "scope",
        "continuity",
        "source_integrity"
      ],
      "properties": {
        "configuration": {
          "$ref": "#/$defs/status"
        },
        "scope": {
          "$ref": "#/$defs/status"
        },
        "continuity": {
          "$ref": "#/$defs/status"
        },
        "source_integrity": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "gap_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "truncated"
      ],
      "properties": {
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_id",
        "method",
        "proof_refs",
        "observed_at"
      ],
      "properties": {
        "observer_id": {
          "$ref": "#/$defs/identifier"
        },
        "method": {
          "$ref": "#/$defs/identifier"
        },
        "proof_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "nullable_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "partial",
        "unknown",
        "failed",
        "unsupported"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "checkpoint": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "milestone",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "milestone": {
          "type": "string",
          "enum": [
            "capture",
            "durable_receipt",
            "processed_input"
          ]
        },
        "value": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "resource_scope",
        "reason_code",
        "recoverability",
        "proof_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "resource_scope": {
          "$ref": "#/$defs/scope"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        },
        "recoverability": {
          "type": "string",
          "enum": [
            "pending",
            "recovered",
            "irrecoverable",
            "unknown"
          ]
        },
        "proof_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
