{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:platform-signal:source-coverage-profile:1",
  "title": "Proposed SourceCoverage profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "required_components",
    "requires_checkpoint",
    "max_interval_seconds",
    "max_verification_age_seconds",
    "max_clock_skew_seconds"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/identifier"
    },
    "required_components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "configuration",
          "scope",
          "continuity",
          "source_integrity"
        ]
      }
    },
    "requires_checkpoint": {
      "type": "boolean"
    },
    "max_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_verification_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
